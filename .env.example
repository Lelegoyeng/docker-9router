# ===== Port & akses =====
# Port di host yang dipakai untuk membuka 9router dari luar container.
# Mapping: host:8001 -> container:20128
ROUTER_PORT=8001
# 0.0.0.0 = semua interface (bisa diakses dari luar). 127.0.0.1 = lokal saja.
ROUTER_BIND_ADDR=0.0.0.0
# Pin versi image bila perlu, contoh: 0.5.81
ROUTER_IMAGE_TAG=latest

# ===== Keamanan =====
# Password login pertama dashboard. WAJIB diganti sebelum deploy publik.
INITIAL_PASSWORD=ganti-password-ini

# Secret internal. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-random-64-hex
API_KEY_SECRET=ganti-dengan-random-64-hex
MACHINE_ID_SALT=ganti-dengan-random-64-hex

# ===== URL publik (penting untuk reverse proxy / domain) =====
# Harus URL yang dipakai browser untuk membuka dashboard.
# Contoh: https://router.contoh.com atau http://203.0.113.10:20128
BASE_URL=http://localhost:8001
NEXT_PUBLIC_BASE_URL=http://localhost:8001
CLOUD_URL=https://9router.com
